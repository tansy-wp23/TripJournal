<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-mode counterpart of values-v31/styles.xml. `splash_background` picks
     up its own values-night override, so only the parent theme changes here. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/android12_splash_logo</item>
    </style>
</resources>
