{
  "version": "0.2.0",
  "configurations": [
    {
      // Default: works on a fresh clone with no setup. Map tiles are OpenStreetMap
      // (no API key needed); everything, including place search, works normally.
      "name": "TripJournal",
      "request": "launch",
      "type": "dart"
    },
    {
      // Real Supabase persistence instead of the mock backend.
      "name": "TripJournal (Supabase)",
      "request": "launch",
      "type": "dart",
      "toolArgs": ["--dart-define=BACKEND_MODE=supabase"]
    }
  ]
}
