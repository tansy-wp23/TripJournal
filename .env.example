# Copy this file to `.env` and fill in the real values.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
#
# Ask Sang You for the actual Supabase credentials — they are NOT in this repo
# and must never be committed. `.env` is gitignored; keep it that way.
#
# You can also find these in the Supabase dashboard:
#   Project Settings → API → Project URL + anon/publishable key

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: enables real Gemini-backed daily advice + food photo detection.
# Get a key from Google AI Studio. Leave blank to keep using the built-in
# mock AI services (no key needed, works fully offline).
GEMINI_API_KEY=
